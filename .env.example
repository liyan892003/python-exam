# 复制为 .env 后填写真实值。生产环境务必使用强随机 SECRET_KEY。

# 会话加密密钥（生产必填，建议 32+ 字符随机串）。可用: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# 数据库连接。本地用 SQLite，生产用 Postgres。
# 本地: sqlite:///./dev.db
# Postgres: postgresql+psycopg2://user:pass@db:5432/python_exam
DATABASE_URL=sqlite:///./dev.db

# DeepSeek API 密钥（OpenAI 兼容）。前往 https://platform.deepseek.com 获取。
DEEPSEEK_API_KEY=

# DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat

# 应用环境: dev / prod
APP_ENV=dev
